<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🛡️ ContentGuard"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#F8FAFC"
            android:gravity="center"
            android:layout_marginTop="32dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="הגנת תוכן אישית"
            android:textSize="16sp"
            android:textColor="#94A3B8"
            android:gravity="center"
            android:layout_marginTop="4dp" />

        <!-- כרטיס סטטוס -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginTop="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="מצב נוכחי"
                android:textSize="12sp"
                android:textColor="#64748B"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ הגנה לא פעילה"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#F8FAFC"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvDelayTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#F59E0B"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <!-- כפתור Admin -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdminProtection"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="הפעל הגנת הסרה"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            app:backgroundTint="#7C3AED"
            app:cornerRadius="12dp"
            android:layout_marginTop="24dp" />

        <!-- כפתור Accessibility -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="הפעל חסימת אפליקציות"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            app:backgroundTint="#059669"
            app:cornerRadius="12dp"
            android:layout_marginTop="12dp" />

        <!-- כפתור DNS -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDns"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="הגדר DNS מסנן"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            app:backgroundTint="#0284C7"
            app:cornerRadius="12dp"
            android:layout_marginTop="12dp" />

        <!-- כפתור ביטול -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelRequest"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="בטל בקשת ביטול"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            app:backgroundTint="#DC2626"
            app:cornerRadius="12dp"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <!-- הסבר -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ℹ️ איך זה עובד"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#F8FAFC" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• DNS מסנן חוסם אתרים לא רצויים\n• נגישות חוסמת אפליקציות ספציפיות\n• הגנת Admin מקשה על הסרה\n• ביטול דורש המתנה של 48 שעות"
                android:textSize="13sp"
                android:textColor="#94A3B8"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
